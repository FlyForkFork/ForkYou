  "mental_model": [
    {
      "title": "它是谁",
      "body": "一套自部署的「服务端微信」：微信跑在 NAS 的容器里，面板是唯一入口，多端浏览器共享同一块远程桌面。"
    },
    {
      "title": "怎么工作",
      "body": "面板经 docker.sock 创建实例容器（Xvfb + 应用 + KasmVNC），把 /desktop/:id/* 反代到实例 nginx，并注入 KasmVNC 凭据；浏览器只拿到面板会话 cookie。"
    },
    {
      "title": "为什么特别",
      "body": "它把「容器编排 + 远程桌面 + RBAC + 升级回滚」缝成一套可运营的服务；代价是面板挂 docker.sock，等于宿主 root。"
    }
  ],
  "architecture": {
    "title": "面板、实例与共享桌面",
    "layers": [
      {
        "name": "接入层",
        "nodes": [
          {
            "id": "browser",
            "label": "浏览器 / PWA",
            "desc": "登录面板、内嵌 noVNC iframe、WebSocket 桌面连接、文件与剪贴板工具。"
          },
          {
            "id": "tls",
            "label": "可选 HTTPS 反代",
            "desc": "Caddy/Nginx/飞牛反代；面板自身只跑 HTTP，TLS 由外层负责。"
          }
        ]
      },
      {
        "name": "面板层",
        "nodes": [
          {
            "id": "web",
            "label": "React SPA",
            "desc": "登录页、实例列表、管理页、桌面页；Desktop.tsx 负责输入桥与音频。"
          },
          {
            "id": "api",
            "label": "Fastify API",
            "desc": "会话鉴权、RBAC、实例 CRUD、文件/卷管理、反代与 WebSocket 升级。"
          },
          {
            "id": "auth",
            "label": "认证 / Host 防护",
            "desc": "bcrypt 密码、30 天滑动会话、双键登录限速、PANEL_ALLOWED_HOSTS 防 DNS rebinding。"
          }
        ]
      },
      {
        "name": "编排层",
        "nodes": [
          {
            "id": "lifecycle",
            "label": "docker.ts 生命周期",
            "desc": "建卷、建容器、启停、升级、自愈；每实例串行、先备镜像后删容器。"
          },
          {
            "id": "selfupdate",
            "label": "自更新",
            "desc": "helper 容器重建面板，健康检查失败自动回滚旧镜像。"
          }
        ]
      },
      {
        "name": "实例层",
        "nodes": [
          {
            "id": "nginx",
            "label": "实例 nginx :3000",
            "desc": "只接实例网络，不映射宿主端口；转发到 websockify。"
          },
          {
            "id": "kasm",
            "label": "KasmVNC / Xvnc",
            "desc": "Xvfb :1 + KasmVNC 1.5.2；-NeverShared 单连接，剥 PNG 剪贴板防 INCR 卡死。"
          },
          {
            "id": "app",
            "label": "微信 / QQ / Chromium",
            "desc": "微信与 QQ 运行时下载到 /config；Chromium 随镜像就绪。"
          }
        ]
      },
      {
        "name": "数据层",
        "nodes": [
          {
            "id": "paneldata",
            "label": "./data-panel",
            "desc": "accounts.json + sessions.json；账号、实例元数据、密码哈希。"
          },
          {
            "id": "volume",
            "label": "woc-data-<id>",
            "desc": "挂到实例 /config；微信本体、聊天记录、浏览器 Cookie 全在这里。"
          }
        ]
      }
